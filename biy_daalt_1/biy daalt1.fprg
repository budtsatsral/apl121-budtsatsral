        <attribute name="edited" value="bXkgdGVjaDtERVNLVE9QLTBKOFI1QTY7MjAyNi0xMC0yNzsxMjo0NDo1NCBBTTsxOzMwNzQ="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="a, b, c, n, sum, i, multiply" type="Integer" array="False" size=""/>
            <declare name="sum1, sum2, sum3, maxSum, maxNum" type="Integer" array="False" size=""/>
            <output expression="&quot;&#1069;&#1093;&#1085;&#1080;&#1081; &#1090;&#1086;&#1086;&quot;" newline="True"/>
            <assign variable="a" expression="InputChecker()"/>
            <assign variable="sum1" expression="NumberSum(a)"/>
            <output expression="&quot;&#1061;&#1086;&#1105;&#1088;&#1076;&#1086;&#1093; &#1090;&#1086;&#1086;&quot;" newline="True"/>
            <assign variable="b" expression="InputChecker()"/>
            <assign variable="sum2" expression="NumberSum(b)"/>
            <output expression="&quot;&#1043;&#1091;&#1088;&#1072;&#1074;&#1076;&#1072;&#1093; &#1090;&#1086;&#1086;&quot;" newline="True"/>
            <assign variable="c" expression="InputChecker()"/>
            <assign variable="sum3" expression="NumberSum(c)"/>
            <output expression="&quot;n &#1090;&#1086;&#1086; &#1086;&#1088;&#1091;&#1091;&#1083;&#1085;&#1072; &#1091;&#1091;&quot;" newline="True"/>
            <assign variable="n" expression="InputChecker()"/>
            <output expression="&quot;toonii urjuuleh husnegt: &quot; &amp;n" newline="True"/>
            <assign variable="sum" expression="NumberSum(n)"/>
            <for variable="i" start="1" end="10" direction="inc" step="1">
                <assign variable="multiply" expression="n * i"/>
                <output expression="n &amp; &quot; x &quot; &amp; i &amp; &quot; = &quot; &amp; multiply" newline="True"/>
            </for>
            <assign variable="maxSum" expression="sum1"/>
            <assign variable="maxNum" expression="1"/>
            <if expression="sum2 &gt; maxSum">
                <then>
                    <assign variable="maxSum" expression="sum2"/>
                    <assign variable="maxNum" expression="2"/>
                </then>
                <else/>
            </if>
            <if expression="sum3 &gt; maxSum">
                <then>
                    <assign variable="maxSum" expression="sum3"/>
                    <assign variable="maxNum" expression="3"/>
                </then>
                <else/>
            </if>
            <if expression="sum1 == sum2 &amp;&amp; sum2 == sum3">
                <then>
                    <output expression="&quot;gurvan too ijil baina&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="sum1 == maxSum || sum2 == maxSum || sum3 == maxSum">
                        <then>
                            <output expression="maxSum &amp; &quot;hamgiin ih tsiifriin niilber &quot;" newline="True"/>
                            <output expression="&quot;ene ni oruulsan &quot; &amp; maxNum &amp; &quot; dahi too baina&quot;" newline="True"/>
                        </then>
                        <else/>
                    </if>
                </else>
            </if>
        </body>
    </function>
    <function name="InputChecker" type="Integer" variable="a">
        <parameters/>
        <body>
            <declare name="a" type="Integer" array="False" size=""/>
            <do expression="a &lt; 1 || a &gt; 99999">
                <output expression="&quot;(&#1069;&#1077;&#1088;&#1101;&#1075; &#1090;&#1086;&#1086; &#1073;&#1086;&#1083;&#1086;&#1085; &#1093;&#1072;&#1084;&#1075;&#1080;&#1081;&#1085; &#1091;&#1088;&#1090;&#1076;&#1072;&#1072; 5 &#1086;&#1088;&#1086;&#1085;&#1075;&#1086;&#1086;&#1089; &#1080;&#1093;&#1075;&#1199;&#1081;)&quot;" newline="True"/>
                <input variable="a"/>
            </do>
            <if expression="a % 2 == 0">
                <then>
                    <output expression="&quot;&#1058;&#1101;&#1075;&#1096; &#1090;&#1086;&#1086; &#1073;&#1072;&#1081;&#1085;&#1072;.&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;&#1057;&#1086;&#1085;&#1076;&#1075;&#1086;&#1081; &#1090;&#1086;&#1086; &#1073;&#1072;&#1081;&#1085;&#1072;.&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
    <function name="NumberSum" type="Integer" variable="sum">
        <parameters>
            <parameter name="a" type="Integer" array="False"/>
        </parameters>
        <body>
            <declare name="sum, digit, reverse" type="Integer" array="False" size=""/>
            <assign variable="sum" expression="0"/>
            <assign variable="reverse" expression="0"/>
            <assign variable="digit" expression="0"/>
            <while expression="a &gt; 0">
                <assign variable="digit" expression="a % 10"/>
                <assign variable="sum" expression="sum + digit"/>
                <assign variable="reverse" expression="reverse * 10 + digit"/>
                <assign variable="a" expression="a / 10"/>
            </while>
            <output expression="&quot;urwuu too &quot; &amp; reverse &amp; &quot; niilber &quot; &amp; sum" newline="True"/>
        </body>
    </function>
</flowgorithm>
